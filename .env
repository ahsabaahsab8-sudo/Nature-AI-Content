# ==============================================================================
# Nature AI Video Agent — Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your real credentials before running.

# ─── KiloCode / LLM Gateway API ──────────────────────────────────────────────
# Obtain your key from https://kilo.ai or configure any OpenAI-compatible provider
KILOCODE_API_KEY=your_kilocode_api_key_here
KILOCODE_BASE_URL=https://api.kilo.ai/api/gateway
KILOCODE_MODEL=stepfun/step-5-preview-free
MAX_TOKENS=32000

# ─── Project & Asset Paths ───────────────────────────────────────────────────
PROJECTS_DIR=./renders
ASSETS_DIR=assets

# ─── Default Video Specifications ────────────────────────────────────────────
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_DURATION=30

# ─── Nature AI Studio Dashboard Authentication ────────────────────────────────
# Set a strong password for web dashboard access via Cloudflare tunnel
STUDIO_PASSWORD=your_secure_studio_password_here
PORT=8787
HOST=127.0.0.1
