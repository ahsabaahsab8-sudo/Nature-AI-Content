# ═══════════════════════════════════════════════════════════════════════════
#  Nature AI — environment
#  Copy this file to `.env` in the same folder and fill in your keys.
# ═══════════════════════════════════════════════════════════════════════════

# ── LLM (KiloCode gateway — OpenAI-compatible) ────────────────────────────
KILOCODE_API_KEY=your-key-here
KILOCODE_BASE_URL=https://api.kilo.ai/api/gateway
KILOCODE_MODEL=stepfun/step-5-preview-free
MAX_TOKENS=32000

# ── Project settings ──────────────────────────────────────────────────────
PROJECTS_DIR=C:\Users\PC\Desktop\Nature AI animation
ASSETS_DIR=assets

# ── Video defaults ────────────────────────────────────────────────────────
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_DURATION=30

# ── Nature AI Studio dashboard (studio/) ──────────────────────────────────
# Password for the dashboard. Omit to run without a password (unsafe on a VPS).
STUDIO_PASSWORD=
# Local port the API listens on. Cloudflare tunnels to it.
STUDIO_PORT=8787
# Absolute/relative paths — both default to the repo-root folders.
# STUDIO_PROJECTS_DIR=C:\path\to\repo
# STUDIO_RENDERS_DIR=C:\path\to\repo\renders
# Force a globally-installed CLI instead of npx:
# STUDIO_HYPERFRAMES=hyperframes
# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
# STUDIO_SECURE_COOKIES=1

# ── Optional integrations ─────────────────────────────────────────────────
# GEMINI_API_KEY=        # AI image captioning during website capture (~$0.001/image, https://aistudio.google.com/apikey)