# Keep shell scripts and Python byte-identical across Windows -> Linux clones.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf

*.mp4  binary
*.jpg  binary
*.png  binary
*.webp binary